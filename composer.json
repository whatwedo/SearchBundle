{
    "name": "whatwedo/search-bundle",
    "type": "symfony-bundle",
    "description": "Full text search on Doctrine entities without external dependencies.",
    "license": "MIT",
    "homepage": "https://whatwedo.github.io/SearchBundle/#/",
    "minimum-stability": "stable",
    "authors": [
        {
            "name": "whatwedo GmbH",
            "email": "welove@whatwedo.ch"
        }
    ],
    "require": {
        "php": ">=8.1",
        "symfony/framework-bundle": "^5.4|^6.0|^7.0",
        "symfony/http-kernel": "^5.4|^6.0|^7.0",
        "doctrine/orm": "^2.11.0",
        "whatwedo/core-bundle": "^1.0",
        "doctrine/doctrine-migrations-bundle": "^3.2"
    },
    "require-dev": {
        "symfony/phpunit-bridge": "^6.0|^7.0",
        "symfony/config": "^6.0|^7.0",
        "symfony/dependency-injection": "^6.0|^7.0",
        "symfony/yaml": "^6.0|^7.0",
        "symfony/validator": "^6.0|^7.0",
        "nyholm/symfony-bundle-test": "^1.8|^2.0",
        "doctrine/doctrine-bundle": "^2.5.5"    ,
        "whatwedo/php-coding-standard": "^1.0",
        "whatwedo/core-bundle": "dev-symfony-7 as 1.0",
        "zenstruck/foundry": "^1.16|^2.0",
        "zenstruck/console-test": "^1.1.0|^2.0",
        "symfony/orm-pack": "^1.0|^2.0",
        "symfony/translation": "^6.0|^7.0",
        "symfony/twig-bundle": "^6.0|^7.0",
        "phpstan/phpstan": "^1.7"
    },
    "autoload": {
        "psr-4": {
            "whatwedo\\SearchBundle\\": "src/",
            "whatwedo\\SearchBundle\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "twbs/icons",
                "version": "1.8.1",
                "source": {
                    "url": "https://github.com/twbs/icons",
                    "type": "git",
                    "reference": "tags/v1.8.1"
                }
            }
        }
    ],
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
